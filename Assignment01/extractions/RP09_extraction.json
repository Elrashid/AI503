  "contribution": {
    "value": "GPTQ is a one-shot weight-only post-training quantization method using approximate second-order information that compresses 175B-parameter GPT models to 3-4 bits in about four GPU hours with negligible accuracy loss.",
    "ev": {
      "page": 1,
      "section": "ABSTRACT",
      "quote": "we propose GPTQ, a new one-shot weight quantization method based on approximate second-order information, that is both highlyaccurate and highly-efficient. Specifically, GPTQ can quantize GPT models with 175 billion parameters in approximately four GPU hours",
      "bbox": [
        142.24,
        212.31,
        468.14,
        459.16
      ],
      "block_id": "/page/0/Text/8"
    }
  },
