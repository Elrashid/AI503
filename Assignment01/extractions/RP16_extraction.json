  "key_results": [
    {
      "value": "3-bit LLaMA-7B (dense-only) PPL on C4 = 7.75 vs FP16 7.08; 0.45% sparsity drops it to 7.56 (gap 0.48); RTN baseline is 28.26.",
      "ev": {
        "page": 7,
        "section": "5.2. Main Results",
